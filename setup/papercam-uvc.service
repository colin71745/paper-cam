# Install as /etc/systemd/system/papercam-uvc.service
# Bridges /dev/video10 (loopback fed by webcam.py) to the UVC gadget endpoint.
#
# NOTE: the exact CLI depends on which uvc-gadget you built; run
# `uvc-gadget -h` to confirm. Current freedesktop.org builds use
# `-d <v4l2 source device>` as below (older versions used -c).
[Unit]
Description=papercam UVC gadget bridge
After=papercam-gadget.service papercam.service
Requires=papercam-gadget.service

[Service]
# Tells uvc-gadget to publish host streaming state here, so webcam.py
# --on-demand knows when to run the camera. Needs the stream-flag patch.
Environment=UVC_GADGET_STREAM_FLAG=/run/papercam-streaming
ExecStart=/usr/local/bin/uvc-gadget -d /dev/video10 uvc.0
# Never leave a stale flag behind (it would pin the camera on).
ExecStopPost=-/bin/rm -f /run/papercam-streaming
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

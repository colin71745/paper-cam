# Install as /etc/systemd/system/papercam.service
# The Python pipeline: camera -> perspective warp -> MJPEG -> /dev/video10
[Unit]
Description=papercam capture and perspective correction
After=papercam-gadget.service

[Service]
WorkingDirectory=/home/pi/papercam
# Without this, Python block-buffers stdout into a pipe and none of
# webcam.py's logging (paper locks, on-demand state, tracebacks)
# ever reaches the journal.
Environment=PYTHONUNBUFFERED=1
# Drop --auto to pin the view to a fixed calibrate.py calibration instead.
# --paper-ae: slow auto-exposure metered on the paper (adapts to changing
# room light); use --lock instead only if lighting is perfectly constant.
# --on-demand: stop capturing whenever no host app is streaming.
# Rotation comes from ROTATE in config.py; add --rotate N to override.
ExecStart=/usr/bin/python3 webcam.py --paper-ae --auto --on-demand
Restart=always
RestartSec=2
User=pi

[Install]
WantedBy=multi-user.target
